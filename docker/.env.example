# Copy to .env next to docker-compose.yaml and edit; ROBOT_CONFIG is required, the rest has defaults.
ROS_DISTRO=iron                          # must match the robot's ROS distribution
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp    # the robot's DDS vendor; rmw_fastrtps_cpp is the image default
ROBOT_CONFIG=../leitstand_client_ros2/config/robot.yaml   # the robot.yaml to run, relative to this directory or absolute
#CYCLONEDDS_CONFIG=/path/to/cyclone.xml  # only with Cyclone; unset mounts docker/cyclone.xml, Cyclone's own defaults
LEITSTAND_LOG_LEVEL=INFO
