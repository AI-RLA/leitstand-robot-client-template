# Copy to .env next to docker-compose.yaml and edit.
# ROBOT_ROS_DISTRO, ROBOT_CONFIG_DIR and ROBOT_CONFIG_FILE are required.

# Must be the ROS distribution the robot runs
ROBOT_ROS_DISTRO=humble
# The robot's DDS vendor. The image defaults to rmw_fastrtps_cpp
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
# Mounted at /config. Absolute or relative to docker/ dir
ROBOT_CONFIG_DIR=../leitstand_client_ros2/config
# The configuration file to load, relative to ROBOT_CONFIG_DIR
ROBOT_CONFIG_FILE=robot.yaml
LEITSTAND_LOG_LEVEL=INFO
